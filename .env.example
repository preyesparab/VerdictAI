# Copy this file to `.env` and adjust values as needed.
# Every variable already has a sensible default in config.py — only set
# what you actually need to override.

# --- Feature flags ---
USE_BM25=true
USE_RERANKER=true
USE_GRAPH_EXPANSION=true
USE_SMALL_TO_BIG=true
USE_SEMANTIC_CACHE=true

# --- LLM provider ---
# Selection order: USE_GEMINI is checked first; if False, USE_GROQ is
# checked next; if that is also False, USE_OLLAMA is checked; if none of
# the three is true, generation raises a configuration error.
USE_GEMINI=true
USE_GROQ=false
USE_OLLAMA=false

# Required when USE_GEMINI=true. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Required when USE_GROQ=true (and USE_GEMINI=false). Get a key at
# https://console.groq.com/keys - a hosted fallback for when Gemini's
# free-tier quota is exhausted (see docs/state/PROGRESS.md's Phase 27
# follow-up entry).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Only used when USE_GEMINI=false, USE_GROQ=false, and USE_OLLAMA=true.
OLLAMA_MODEL=mistral
OLLAMA_BASE_URL=http://localhost:11434

# Provider-agnostic generation parameters.
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60.0

# --- Retrieval parameters ---
TOP_K_DENSE=20
TOP_K_BM25=20
TOP_K_FINAL=8
MAX_CONTEXT_TOKENS=4000
CACHE_SIMILARITY_THRESHOLD=0.95
RRF_K=60

# --- API server ---
# Origins the FastAPI backend (api/main.py) accepts browser requests from.
# Parsed as a JSON array by pydantic-settings.
CORS_ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# --- Database ---
# SQLAlchemy connection URL for the PostgreSQL relational store (replaces
# the old SQLITE_DB_PATH/SQLITE_DIR). For local dev: docker compose up -d postgres
DATABASE_URL=postgresql+psycopg2://repomind:repomind@localhost:5432/repomind

# --- Logging ---
LOG_LEVEL=INFO
